      1 +#!/usr/bin/env python3
      2 +"""
      3 +源码拉取后的统一构建入口。
      4 +
      5 +目标机只需要：
      6 +1. git pull / git clone
      7 +2. 运行本脚本
      8 +
      9 +脚本会自动：
     10 +- 识别当前机器对应的发布目标
     11 +- 创建独立构建虚拟环境
     12 +- 安装 requirements.txt 与 pyinstaller
     13 +- macOS 下按需安装 create-dmg
     14 +- 调用 build_app.py 完成正式打包
     15 +"""
     16 +
     17 +from __future__ import annotations
     18 +
     19 +import argparse
     20 +import shutil
     21 +import subprocess
     22 +import sys
     23 +from pathlib import Path
     24 +
     25 +import build_app
     26 +
     27 +
     28 +BASE_DIR = Path(__file__).parent.resolve()
     29 +DEFAULT_BUILD_VENV_ROOT = BASE_DIR / ".build-venvs"
     30 +
     31 +
     32 +def parse_args() -> argparse.Namespace:
     33 +    parser = argparse.ArgumentParser(description="Bootstrap build environ
         ment and package the app on the current host.")
     34 +    parser.add_argument(
     35 +        "--target",
     36 +        choices=build_app.SUPPORTED_TARGETS,
     37 +        help="Build target. Defaults to the current host target.",
     38 +    )
     39 +    parser.add_argument(
     40 +        "--python",
     41 +        help="Python interpreter used to create the build virtualenv. Def
         aults to the current interpreter.",
     42 +    )
     43 +    parser.add_argument(
     44 +        "--venv-root",
     45 +        default=str(DEFAULT_BUILD_VENV_ROOT),
     46 +        help="Root directory for build virtualenvs. Default: .build-venvs
         ",
     47 +    )
     48 +    parser.add_argument(
     49 +        "--skip-installer",
     50 +        action="store_true",
     51 +        help="Only build the application and skip dmg/iss packaging.",
     52 +    )
     53 +    parser.add_argument(
     54 +        "--skip-deps",
     55 +        action="store_true",
     56 +        help="Skip dependency installation and reuse the existing build v
         irtualenv.",
     57 +    )
     58 +    return parser.parse_args()
     59 +
     60 +
     61 +def run(cmd: list[str], *, cwd: Path | None = None):
     62 +    print("Command:", " ".join(cmd))
     63 +    subprocess.run(cmd, check=True, cwd=str(cwd or BASE_DIR))
     64 +
     65 +
     66 +def ensure_build_venv(venv_dir: Path, python_cmd: str) -> Path:
     67 +    python_path = Path(python_cmd).expanduser()
     68 +    if not python_path.is_absolute():
     69 +        resolved = shutil.which(python_cmd)
     70 +        if not resolved:
     71 +            raise RuntimeError(f"Python interpreter not found: {python_cm
         d}")
     72 +        python_path = Path(resolved)
     73 +
     74 +    if not venv_dir.exists():
     75 +        run([str(python_path), "-m", "venv", str(venv_dir)])
     76 +
     77 +    if sys.platform == "win32":
     78 +        venv_python = venv_dir / "Scripts" / "python.exe"
     79 +    else:
     80 +        venv_python = venv_dir / "bin" / "python"
     81 +
     82 +    if not venv_python.exists():
     83 +        raise RuntimeError(f"Build virtualenv is missing python: {venv_py
         thon}")
     84 +
     85 +    return venv_python
     86 +
     87 +
     88 +def install_build_dependencies(venv_python: Path):
     89 +    run([str(venv_python), "-m", "pip", "install", "--upgrade", "pip"])
     90 +    run([str(venv_python), "-m", "pip", "install", "-r", "requirements.tx
         t"])
     91 +    run([str(venv_python), "-m", "pip", "install", "pyinstaller"])
     92 +
     93 +
     94 +def ensure_create_dmg():
     95 +    if shutil.which("create-dmg"):
     96 +        return
     97 +
     98 +    brew = shutil.which("brew")
     99 +    if not brew:
    100 +        raise RuntimeError("create-dmg is not installed and Homebrew is u
         navailable. Install create-dmg first.")
    101 +
    102 +    run([brew, "install", "create-dmg"])
    103 +
    104 +
    105 +def main():
    106 +    args = parse_args()
    107 +    target_key = args.target or build_app.infer_default_target()
    108 +    target = build_app.ensure_supported_target(target_key)
    109 +    build_app.ensure_host_can_build(target)
    110 +
    111 +    venv_root = Path(args.venv_root).expanduser()
    112 +    venv_dir = venv_root / target.key
    113 +    python_cmd = args.python or sys.executable
    114 +
    115 +    print("=" * 60)
    116 +    print(f"{build_app.APP_DISPLAY_NAME} bootstrap build")
    117 +    print(f"Target: {target.key}")
    118 +    print(f"Build venv: {venv_dir}")
    119 +    print("=" * 60)
    120 +
    121 +    venv_python = ensure_build_venv(venv_dir, python_cmd)
    122 +
    123 +    if not args.skip_deps:
    124 +        install_build_dependencies(venv_python)
    125 +
    126 +    if target.os_name == "macos" and not args.skip_installer:
    127 +        ensure_create_dmg()
    128 +
    129 +    build_cmd = [str(venv_python), "build_app.py", "--target", target.key
         , "--skip-pyinstaller-install"]
    130 +    if args.skip_installer:
    131 +        build_cmd.append("--skip-installer")
    132 +    run(build_cmd)
    133 +
    134 +
    135 +if __name__ == "__main__":
    136 +    main()

